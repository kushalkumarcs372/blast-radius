# Copy this file to .env and fill in real values. Never commit .env.

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# LLM: the first provider is tried first, the other is the fallback.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
